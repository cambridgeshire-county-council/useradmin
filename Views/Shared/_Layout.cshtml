@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | UserAdmin</title>
    <meta name="theme-color" content="#243746" />
    <script type="importmap"></script>
    <link rel="icon" type="image/svg+xml" href="~/brand/useradmin-mark.svg" />
    <link rel="alternate icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/brand/useradmin-icon-192.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PSScriptWebApp.styles.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-dark" aria-label="Primary navigation">
            <div class="container-xl">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="UserAdmin home">
                    <img class="brand-mark" src="~/brand/useradmin-mark.svg" alt="" width="40" height="40" />
                    <span class="brand-lockup">
                        <span class="brand-name"><span>User</span><strong>Admin</strong></span>
                        <span class="brand-descriptor">Identity administration</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#primaryNavigation" aria-controls="primaryNavigation"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="primaryNavigation">
                    <ul class="navbar-nav ms-lg-4 me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Users" && currentAction == "New" ? "active" : null)"
                               aria-current="@(currentController == "Users" && currentAction == "New" ? "page" : null)"
                               asp-area="" asp-controller="Users" asp-action="New">New user</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Users" && (currentAction == "Search" || currentAction == "Details") ? "active" : null)"
                               aria-current="@(currentController == "Users" && (currentAction == "Search" || currentAction == "Details") ? "page" : null)"
                               asp-area="" asp-controller="Users" asp-action="Search">Search users</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Users" && currentAction == "MarkForDeletion" ? "active" : null)"
                               aria-current="@(currentController == "Users" && currentAction == "MarkForDeletion" ? "page" : null)"
                               asp-area="" asp-controller="Users" asp-action="MarkForDeletion">Manage deletion</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Users" && currentAction == "MarkedForDeletion" ? "active" : null)"
                               aria-current="@(currentController == "Users" && currentAction == "MarkedForDeletion" ? "page" : null)"
                               asp-area="" asp-controller="Users" asp-action="MarkedForDeletion">Marked accounts</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Scripts" ? "active" : null)"
                               aria-current="@(currentController == "Scripts" ? "page" : null)"
                               asp-area="" asp-controller="Scripts" asp-action="Index">Operational scripts</a>
                        </li>
                    </ul>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="signed-in-user" title="Authenticated Windows account">
                            <span class="signed-in-label">Signed in</span>
                            <span class="signed-in-name">@User.Identity.Name</span>
                        </span>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="page-shell container-xl">
        <main role="main" class="page-content">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container-xl d-flex flex-column flex-sm-row justify-content-between gap-2">
            <span>&copy; @DateTime.UtcNow.Year Cambridgeshire County Council</span>
            <span>UserAdmin <span aria-hidden="true">&middot;</span> Internal service</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
