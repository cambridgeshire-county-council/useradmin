@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="system-message system-message-danger">
    <p class="eyebrow">Something went wrong</p>
    <h1>We couldn't complete that request</h1>
    <p class="lead">No further action has been taken. Try again or contact your administrator if the problem continues.</p>
    @if (Model.ShowRequestId)
    {
        <p class="request-id"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
    }
</div>
