@{
    ViewData["Title"] = "Home";
}

<div class="py-4">
    <div class="text-center mb-4">
        <h1 class="display-4">UserAdmin Toolbox</h1>
        <p class="lead">Choose a task to jump straight into the user administration tools.</p>
    </div>

    <div class="row g-3">
        <div class="col-md-6 col-lg-4">
            <a class="btn btn-primary w-100" asp-controller="Users" asp-action="New">New User</a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a class="btn btn-primary w-100" asp-controller="Users" asp-action="Search">Search Users</a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a class="btn btn-outline-secondary w-100" asp-controller="Users" asp-action="MarkForDeletion">Mark for Deletion</a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a class="btn btn-outline-secondary w-100" asp-controller="Users" asp-action="MarkedForDeletion">Marked for Deletion</a>
        </div>
        <div class="col-md-6 col-lg-4">
            <a class="btn btn-outline-secondary w-100" asp-controller="Scripts" asp-action="Index">Powershell Script list</a>
        </div>
    </div>
</div>
